{
  // Configuration de déploiement Cloudflare.
  //
  // Cloudflare a deux portes d'entrée pour un site statique : « Pages » et
  // « Workers avec ressources statiques ». Les deux savent se brancher sur un
  // dépôt git, les deux lisent public/_headers — donc les deux tiennent la
  // politique de sécurité et l'isolation d'origine dont dépend l'arrêt propre
  // des calculs longs. Ce fichier décrit la seconde, la seule qui se configure
  // dans le dépôt plutôt que dans une interface : la configuration se relit,
  // se revoit et se corrige comme du code.
  //
  //   npx wrangler login     (une fois, ouvre le navigateur)
  //   npm run build && npm run deploiement
  //
  // Une fois le projet créé, le brancher sur le dépôt depuis le tableau de
  // bord (Workers Builds) pour retrouver le déploiement à chaque poussée.
  "name": "seqops",
  "compatibility_date": "2026-09-10",
  "assets": {
    "directory": "./dist",
    // L'application tient dans une seule page : toute autre adresse doit la
    // servir plutôt que de rendre une erreur.
    "not_found_handling": "single-page-application"
  },
  "observability": {"enabled": true}
}
